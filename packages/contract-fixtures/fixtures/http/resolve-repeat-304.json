        "context": {
          "platform": "ios",
          "appVersion": "1.0.0",
          "clientId": "6f9a1c2b-3d4e-4f5a-8b9c-0d1e2f3a4b5c",
          "attributes": {}
        },
        "query": "platform=ios&appVersion=1.0.0&clientId=6f9a1c2b-3d4e-4f5a-8b9c-0d1e2f3a4b5c",
        "ifNoneMatch": {
          "fromStep": 1
        }
      },
      "response": {
        "status": 304,
        "etag": "\"60495a641acfc844\"",
        "body": null
      },
      "expect": {
        "activatedVersion": 1,
        "changed": false,
        "reads": [
          {
            "key": "enable_enrollment",
