{
  "name": "resolve-repeat-304",
  "description": "A second fetch sends the stored validator and the server answers 304: freshness is refreshed, values and version are untouched.",
  "setup": {
    "conditions": [],
    "parameters": [
      {
        "key": "enable_enrollment",
        "type": "boolean",
        "defaultValue": true,
        "conditionalValues": []
      }
    ],
    "publish": true
  },
  "steps": [
    {
      "request": {
        "path": "/v1/resolve",
        "context": {
          "platform": "ios",
          "appVersion": "1.0.0",
          "clientId": "6f9a1c2b-3d4e-4f5a-8b9c-0d1e2f3a4b5c",
          "attributes": {}
