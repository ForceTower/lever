[
  {
    "name": "gte matches at the boundary",
    "snapshot": {
      "format": 1,
      "parameters": {
        "gate": {
          "type": "boolean",
          "defaultValue": false,
          "conditionalValues": [
            {
              "condition": {
                "name": "5.2+",
                "clauses": [{ "kind": "appVersion", "op": "gte", "value": "5.2.0" }]
              },
              "value": true
            }
          ]
        }
      }
    },
    "context": { "appVersion": "5.2.0", "attributes": {} },
    "expected": { "values": { "gate": { "type": "boolean", "value": true } } }
  },
