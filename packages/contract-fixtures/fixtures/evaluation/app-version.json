  {
    "name": "prerelease identifiers order numerically then lexically: beta.2 gt beta.1, alpha lt beta",
    "snapshot": {
      "format": 1,
      "parameters": {
        "after_beta_1": {
          "type": "boolean",
          "defaultValue": false,
          "conditionalValues": [
            {
              "condition": {
                "name": "gt-beta-1",
                "clauses": [{ "kind": "appVersion", "op": "gt", "value": "5.2.0-beta.1" }]
              },
              "value": true
            }
          ]
        },
        "before_beta": {
          "type": "boolean",
          "defaultValue": false,
          "conditionalValues": [
            {
              "condition": {
                "name": "lt-beta",
                "clauses": [{ "kind": "appVersion", "op": "lt", "value": "5.2.0-beta" }]
              },
              "value": true
            }
          ]
        }
      }
    },
    "context": { "appVersion": "5.2.0-beta.2", "attributes": {} },
    "expected": {
      "values": {
        "after_beta_1": { "type": "boolean", "value": true },
        "before_beta": { "type": "boolean", "value": false }
      }
    }
  },
