{
  "name": "lever",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "check": "oxlint --type-aware && oxfmt --check . && tsc --noEmit",
    "fix": "oxlint --type-aware --fix && oxfmt .",
    "fmt": "oxfmt .",
    "lint": "oxlint --type-aware",
    "test": "bun test",
    "fixtures:update": "LEVER_UPDATE_FIXTURES=1 bun test apps/api/src/api/http-fixtures.test.ts"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "^7.0.2"
  }
}
